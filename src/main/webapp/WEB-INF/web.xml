<?xml version="1.0" encoding="UTF-8"?>
<!--
  Descripteur de déploiement du TP1 (Tomcat 9 / Servlet 4.0 / javax.servlet).

  Rappel de la consigne : une seule méthode d'enregistrement par composant.
   - Les servlets sont déclarées par annotation (@WebServlet).
   - LoggingFilter et SecurityFilter sont déclarés ICI (exercice 1.4.1 - 3 et 6),
     donc PAS d'annotation @WebFilter dans leurs classes.
   - ApplicationListener est déclaré ICI (exercice 1.4.2 - 6) ;
     les autres listeners utilisent @WebListener.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>TP1 - Web Technologies</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- ===================== Listeners ===================== -->
    <listener>
        <listener-class>isep.lab1.listeners.ApplicationListener</listener-class>
    </listener>

    <!-- ===================== Filtres ===================== -->
    <filter>
        <filter-name>LoggingFilter</filter-name>
        <filter-class>isep.lab1.filters.LoggingFilter</filter-class>
        <init-param>
            <param-name>logPrefix</param-name>
            <param-value>[TP1-LOG]</param-value>
        </init-param>
    </filter>

    <filter>
        <filter-name>SecurityFilter</filter-name>
        <filter-class>isep.lab1.filters.SecurityFilter</filter-class>
    </filter>

    <!--
      L'ORDRE DES <filter-mapping> = L'ORDRE D'EXÉCUTION DANS LA FilterChain.
      Exercice 1.4.1 - 6 : tester d'abord dans cet ordre, puis inverser
      les deux blocs ci-dessous et refaire les tests.
    -->
    <filter-mapping>
        <filter-name>LoggingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>SecurityFilter</filter-name>
        <url-pattern>/ListItems</url-pattern>
    </filter-mapping>

    <!-- ===================== Session ===================== -->
    <session-config>
        <!-- en minutes -->
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
